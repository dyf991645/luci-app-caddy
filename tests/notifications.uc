import {fixtureFactory} from './fixture-store.uc';
import {mkdir,writefile,chmod} from 'fs';
let root=ARGV[1];
let m=fixtureFactory(ARGV[0])({root,certificate_module:ARGV[3],certificate_options:{root,now:time()+8*86400,command:ARGV[2],logfile:root+'/events'},now:time()+8*86400});
let r=m.check();
assert(r.ok && r.alerts[0].phase=='expired','background check creates actual PEM expiry alert');
let id=r.alerts[0].episode_id;
assert(fixtureFactory(ARGV[0])({root,certificate_module:ARGV[3],certificate_options:{root,now:time()+8*86400,command:ARGV[2],logfile:root+'/events'},now:time()+8*86400}).check().alerts[0].episode_id==id,'restart preserves episode');
assert(m.status().webhook.enabled==false,'external notification default off');
assert(!m.save({enabled:true,url:'http://user:pass@127.0.0.1/'}).ok,'userinfo rejected');
assert(!m.save({enabled:true,url:'http://127.0.0.1/a b'}).ok,'URL whitespace rejected');
assert(m.save({enabled:true,url:'http://127.0.0.1:29082/ok?token=URL_CANARY',headers:{Authorization:'Bearer HEADER_CANARY'}}).ok,'explicit HTTP loopback setting accepted');
assert(index(sprintf('%J',m.status()),'CANARY')<0,'read status has no webhook secrets');
print('PASS background expiry, restart dedup and write-only configuration\n');
assert(m.save({enabled:false}).ok,'disable delivery without exposing retained target');
let key=root+'/replacement.key',crt=root+'/data/certificates/fixture/leaf/replacement.crt';
assert(system(['/usr/bin/openssl','req','-x509','-newkey','ec','-pkeyopt','ec_paramgen_curve:P-256','-nodes','-keyout',key,'-out',crt,'-days','30','-subj','/CN=Replacement','-addext','subjectAltName=DNS:a.example.test,DNS:b.example.test'],5000)==0,'generate valid covering replacement');
let replacement=m.check();
assert(replacement.alerts[0].phase=='recovered','valid replacement recovers expired episode');
let again=m.check();
assert(again.alerts[0].phase=='recovered' && length(filter(again.deliveries,e=>e.type=='recovered'))==1,'retained expired leaf cannot reopen recovered episode');
print('PASS actual covering PEM replacement recovery is stable\n');
