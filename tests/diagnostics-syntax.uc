import {fixtureFactory} from './fixture-store.uc';
'use strict';
import {writefile} from 'fs';
let api=fixtureFactory(ARGV[0])({root:ARGV[1],command:ARGV[2]});
let config={version:2,mode:'manual',manual_caddyfile:'http://test.invalid {\n totally_invalid_PRIVATE_CANARY\n}\n',settings:{http_port:10080,https_port:10443,email:'',storage:ARGV[1]+'/data'},sites:[{}]};
assert(api.draft_save({config,expected_revision:0}).ok,'save bad syntax as draft');
writefile(ARGV[1]+'/operation-evidence.json','corrupt evidence fixture');
let result=api.preview({config});
assert(result.ok==false && result.diagnostic?.category=='caddyfile_syntax' && result.diagnostic.line==2,'bad manual syntax reports safe source line');
assert(index(sprintf('%J',result),'PRIVATE_CANARY')<0,'syntax feedback never exposes private literal');
writefile(ARGV[1]+'/empty-log','');
let events=fixtureFactory(ARGV[3])({root:ARGV[1],logfile:ARGV[1]+'/empty-log'}).logs({level:'error'});
assert(events.ok && length(events.entries)==1 && events.entries[0].event=='config_adapt_failed','real apply/preview error is visible through safe log API');
assert(index(sprintf('%J',events),'PRIVATE_CANARY')<0,'application event does not copy syntax literal');
let snippet={...config,mode:'form',sites:[{domain:'snippet.invalid',upstreams:['http://127.0.0.1:30081'],balance:'round_robin',path:'',strip:false,challenge:'http-01',advanced_snippet:'unknown_PRIVATE_SNIPPET'}]};
let invalidSnippet=api.preview({config:snippet});
assert(invalidSnippet.diagnostic?.source=='advanced_snippet' && invalidSnippet.diagnostic.line==1,'snippet feedback removes synthetic wrapper line');
for(let i=0;i<34;i++)api.preview({config});
let retained=fixtureFactory(ARGV[3])({root:ARGV[1],logfile:ARGV[1]+'/empty-log'}).logs({});
assert(length(retained.entries)==32,'actual repeated CLI failure event retention is capped');
assert(index(sprintf('%J',retained),'PRIVATE_')<0,'retained events never leak source literals');
print('PASS safe manual syntax line feedback\n');
