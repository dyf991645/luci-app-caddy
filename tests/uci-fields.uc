import { cursor } from 'uci';
import { mkdir,writefile,readfile,chmod,glob } from 'fs';
let root=ARGV[0],modules=ARGV[1],confdir=root+'/config';mkdir(root,0700);mkdir(confdir,0700);
writefile(confdir+'/caddy',"config manager 'config'\n option schema '3'\n");
let cfg={version:2,settings:{http_port:26080,https_port:26443,email:'',storage:root+'/data',access_log:false,default_challenge:'http-01'},auth:{authelia:{backend:'http://127.0.0.1:9091',uri:'/api/authz/forward-auth',portal:'https://login.example.test'}},sites:[{enabled:true,domain:'uci.example.test',upstreams:['http://127.0.0.1:26081','http://127.0.0.1:26082'],balance:'round_robin',path:'',strip:false,challenge:'global',auth:{mode:'authelia',source:'global'},advanced_snippet:'header X-Test test'}]};
let create=loadfile(modules+'/uci-store.uc')(),a=create({root,confdir,savedir:root+'/a'}),b=create({root,confdir,savedir:root+'/b'});
a.initialize();a.write({config:cfg});assert(a.commit(),'initial current-format commit');let before=a.read();assert(a.equivalent(before.config,cfg),'current UCI model roundtrip');
let c=cursor(confdir,root+'/uci-committed');assert(c.get('caddy','config','http_port')=='26080','actual global option');
assert(c.get('caddy','uci','domain')=='uci.example.test','actual domain option');
assert(length(c.get('caddy','uci','upstream'))==2,'ordered native backend list');
assert(c.get('caddy','config','revision')==null,'no revision pointer');
let staged=json(sprintf('%J',cfg));staged.sites[0].upstreams[0]='http://127.0.0.1:26083';a.write({config:staged});
assert(a.read().config.sites[0].upstreams[0]!=b.read().config.sites[0].upstreams[0],'session isolation');
c=cursor(confdir,root+'/a');c.load('caddy');assert(index(sprintf('%J',c.changes('caddy')),'upstream')>=0,'native changes name actual option');assert(c.revert('caddy'),'revert fields');assert(a.equivalent(a.read().config,cfg),'revert restores model');
c=cursor(confdir,root+'/b');c.set('caddy','uci','domain','edited.example.test');assert(c.save('caddy'),'CLI save');assert(b.read().revision!=before.revision && b.read().config.sites[0].domain=='edited.example.test','direct field edits detected without revision increment');
assert(b.commit(),'commit fields');assert(a.read().config.sites[0].domain=='edited.example.test','committed fields shared');
let token='canaryPrivateToken',ref=a.saveCredential(token);assert(a.secret('credential',ref).token==token,'pending token resolves before encoding');
let profiles=[{username:'alice',hash:'canaryHash'}],profile=a.saveProfile(profiles);assert(a.equivalent(a.secret('basic',profile),profiles),'pending accounts resolve before encoding');
let inline=a.read().config;inline.settings.cloudflare_credential=ref;inline.auth.basic={profile};a.write({config:inline});
a.saveNotifications({enabled:true,url:'https://hook.example.test/secret',headers:{Authorization:'canaryHeader'}});a.saveService({running:true,enabled:true});
assert(a.notifications().enabled && !b.notifications().enabled,'notification session isolation');assert(a.service().running && !b.service().running,'service session isolation');
c=cursor(confdir,root+'/a');let deltas=sprintf('%J',c.changes('caddy'));for(let value in [token,'canaryHash','canaryHeader'])assert(index(deltas,value)>=0,'single-file UCI changes carry direct values');
assert(a.commit(),'auxiliary UCI commit');assert(b.notifications().enabled && b.service().enabled,'committed notification and service settings');
assert(readfile(root+'/notifications.json')==null && !length(glob(root+'/basic-profiles/*')) && !length(glob(root+'/credentials/*')),'no new editable JSON configuration');
a.initialize();assert(a.read().config.sites[0].domain=='edited.example.test','idempotent migration preserves UCI edits');
print('PASS UCI fields, native changes, direct edits, list order, session isolation, revert, private credentials/auth/notifications/service and idempotence\n');
