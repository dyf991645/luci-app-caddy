'use strict';
import {mkdir,chmod,writefile} from 'fs';
let root=ARGV[1];mkdir(root,0700);chmod(root,0700);
let config={version:2,settings:{http_port:80,https_port:443},sites:[{domain:'test.invalid',upstreams:['http://127.0.0.1:30081','http://127.0.0.1:30082']}]};
writefile(root+'/draft.json',sprintf('%J',{revision:1,config}));chmod(root+'/draft.json',0600);
writefile(root+'/active.json',sprintf('%J',{apps:{http:{servers:{proxy:{listen:[':10080']}}}}}));chmod(root+'/active.json',0600);
let api=loadfile(ARGV[0])()({root,command:ARGV[2]});
let status=api.status();
assert(status.binary.installed && index(status.binary.version,'v2.11.8 ')==0,'actual binary version');
assert(status.binary.cloudflare==true && status.architecture.kernel=='aarch64','actual module and architecture');
assert(status.package.state=='installed' && index(status.package.version,'2.11.8-r')>=0,'actual APK version');
assert(length(filter(status.listeners,l=>l.port==80 && l.owner=='uhttpd'))>=1,'real uhttpd listener detected');
assert(length(filter(status.ports,p=>p.port==80 && p.state=='conflict'))==1,'uhttpd conflict distinguished');
config.settings.http_port=10080;config.settings.https_port=10443;
writefile(root+'/draft.json',sprintf('%J',{revision:2,config}));
config.settings.http_port=30081;writefile(root+'/draft.json',sprintf('%J',{revision:3,config}));
assert(length(filter(api.status().ports,p=>p.port==30081 && p.state=='own_service'))==1,'actual Caddy listener is not reported as another service conflict');
let probe=api.probe({confirm:true});
assert(probe.ok && probe.backends[0].state=='tcp_reachable' && probe.backends[1].state=='unreachable','explicit configured backend probes reflect live and refused TCP');
assert(api.probe({confirm:false}).ok==false && api.probe({confirm:true,url:'http://anything.invalid:80'}).ok==false,'probe cannot accept arbitrary targets or implicit action');
chmod(root+'/active.json',0644);
assert(api.status().permissions.active_private==false,'unsafe actual file permission visible');
let absent=loadfile(ARGV[0])()({root,command:ARGV[2],binary:root+'/missing'}).status();
assert(absent.binary.installed==false && absent.binary.version==null && absent.binary.cloudflare==null,'missing binary does not invent installed/module evidence');
let unavailable=loadfile(ARGV[0])()({root,command:root+'/no-helper'}).status();
assert(unavailable.ok && unavailable.binary.cloudflare==null && unavailable.listeners_available==false,'failed helper/module query remains unknown rather than inventing missing modules or free ports');
print('PASS actual deployment diagnostics and bounded configured TCP probes\n');
