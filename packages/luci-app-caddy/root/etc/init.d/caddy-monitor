#!/bin/sh /etc/rc.common
# Independent of caddy's running/autostart state and browser sessions.
START=96
STOP=10
USE_PROCD=1
start_service() {
 procd_open_instance
 procd_set_param command /usr/bin/ucode /usr/share/caddy-manager/notification-worker.uc
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 0
 procd_set_param stderr 0
 procd_close_instance
}
