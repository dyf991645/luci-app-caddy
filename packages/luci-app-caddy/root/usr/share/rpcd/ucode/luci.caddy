'use strict';
import { access, popen } from 'fs';
import { connect } from 'ubus';
import { init_enabled, init_action } from 'luci.sys';

function output(command) {
	let pipe = popen(command, 'r');
	if (!pipe)
		return null;
	let text = trim(pipe.read('all'));
	return pipe.close() == 0 ? text : null;
}

function manager(request,applying) {
	let store=loadfile('/usr/share/caddy-manager/uci-store.uc')()({session:request?.args?.ubus_rpc_session});
	let offline=false;
	if(applying) {
		let bus=connect(),services=bus?.call('service','list',{name:'caddy'});
		if(services==null)die('Unable to observe Caddy service');
		offline=true;for(let name,instance in services?.caddy?.instances)if(instance.running)offline=false;
		bus.disconnect();
	}
	return loadfile('/usr/share/caddy-manager/config.uc')()({store,offline});
}

return {
	'luci.caddy': {
		logs: {args:{level:'',kind:''},call:function(request) {return loadfile('/usr/share/caddy-manager/diagnostics.uc')()().logs({level:request.args.level || 'all',kind:request.args.kind || 'all'});}},
		diagnostics: {call:function(request) {return loadfile('/usr/share/caddy-manager/diagnostics.uc')()({store:loadfile('/usr/share/caddy-manager/uci-store.uc')()({session:request?.args?.ubus_rpc_session})}).status();}},
		backend_probe: {args:{confirm:false},call:function(request) {let args={...request.args};delete args.ubus_rpc_session;return loadfile('/usr/share/caddy-manager/diagnostics.uc')()({store:loadfile('/usr/share/caddy-manager/uci-store.uc')()({session:request?.args?.ubus_rpc_session})}).probe(args);}},
		notification_status: {call:function(request) {return loadfile('/usr/share/caddy-manager/notifications.uc')()({store:loadfile('/usr/share/caddy-manager/uci-store.uc')()({session:request?.args?.ubus_rpc_session})}).status();}},
		notification_save: {args:{enabled:false,url:'',headers:{},method:'',body_mode:'',body:''},call:function(request) {return loadfile('/usr/share/caddy-manager/notifications.uc')()({store:loadfile('/usr/share/caddy-manager/uci-store.uc')()({session:request?.args?.ubus_rpc_session})}).save({enabled:request.args.enabled,url:request.args.url,headers:request.args.headers,method:request.args.method,body_mode:request.args.body_mode,body:request.args.body});}},
		basic_profile_save: {args:{scope:'',config:{},users:[],expected_revision:0},call:function(request) {return manager(request).basic_profile_save(request.args);}},
		tls_save: {args:{default_challenge:'',expected_revision:0,site_challenges:{},email:'',update_email:false,wildcard_domains:[],update_wildcard_domains:false},call:function(request) {return manager(request).tls_save({default_challenge:request.args.default_challenge,expected_revision:request.args.expected_revision,site_challenges:request.args.site_challenges,...(request.args.update_email?{email:request.args.email}:{}),...(request.args.update_wildcard_domains?{wildcard_domains:request.args.wildcard_domains}:{})});}},
		credential_status: {call:function(request) {return manager(request).credential_status();}},
		credential_save: {args:{token:'',expected_revision:0},call:function(request) {return manager(request).credential_save(request.args);}},
		draft_edit: {call: function(request) {return manager(request).draft_edit();}},
		certificates: {call:function() {return loadfile('/usr/share/caddy-manager/certificates.uc')()().status();}},
		draft_get: {call: function(request) {return manager(request).draft_get();}},
		draft_save: {args:{config:{},expected_revision:0},call:function(request) {return manager(request).draft_save(request.args);}},
		config_preview: {args:{config:{}},call:function(request) {return manager(request).preview(request.args);}},
		config_apply: {args:{expected_revision:0},call:function(request) {let result=manager(request,true).apply(request.args);if(result.ok && system(['/usr/bin/ucode','/usr/share/caddy-manager/uci-services.uc'],10000)!=0)return {ok:false,error:'Configuration applied; service settings could not be applied'};return result;}},
		status: {
			call: function(request) {
				let installed = access('/usr/bin/caddy');
				let result = {
					installed: !!installed,
					desired:loadfile('/usr/share/caddy-manager/uci-store.uc')()({session:request?.args?.ubus_rpc_session}).service(),
					running: false,
					enabled: !!init_enabled('caddy'),
					uptime_seconds:null,memory_kib:null,
					version: installed ? output('/usr/bin/caddy version 2>/dev/null') : null,
					modules: []
				};
				if (installed) {
					let modules = output('/usr/bin/caddy list-modules --versions 2>/dev/null');
					result.modules = modules ? filter(split(modules, '\n'), line => length(line) > 0) : [];
				}
				let bus = connect();
				if (!bus) {
					result.running = null;
					result.error = 'Unable to query procd';
					return result;
				}
				let service = bus.call('service', 'list', { name: 'caddy' });
				if (service == null) {
					result.running = null;
					result.error = 'Unable to query procd';
				}
				for (let name, instance in service?.caddy?.instances)
					if (instance.running) {
						result.running = true;
						let metrics=loadfile('/usr/share/caddy-manager/process-metrics.uc')()(instance.pid);
						result.uptime_seconds=metrics.uptime_seconds;result.memory_kib=metrics.memory_kib;
					}
				bus.disconnect();
				return result;
			}
		},
		service_save: {args:{running:false,enabled:false},call:function(request) {let store=loadfile('/usr/share/caddy-manager/uci-store.uc')()({session:request?.args?.ubus_rpc_session});store.saveService({running:request.args.running,enabled:request.args.enabled});return {ok:true};}},
		action: {
			args: { action: 'action' },
			call: function(request) {
				let action = request.args.action;
				if (index(['start', 'stop', 'restart', 'reload', 'enable', 'disable'], action) < 0)
					return { ok: false, error: 'Unsupported service action' };
				if (!access('/etc/init.d/caddy'))
					return { ok: false, error: 'Caddy service is not installed' };
				let code = init_action('caddy', action);
				return code === 0 ? { ok: true } : {
					ok: false, error: 'Caddy service action failed', code
				};
			}
		}
	}
};
