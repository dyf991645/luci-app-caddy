#!/bin/sh
# Fixed private file arguments only. No URL, headers or response body in argv/logs.
set -eu
umask 077
[ "$#" -eq 3 ] || exit 2
ulimit -f 8
webhook_config="$1"
webhook_payload="$2"
webhook_result="$3"
set --
if [ -s "$webhook_payload" ]; then set -- --data-binary "@$webhook_payload"; fi
exec /usr/bin/curl --disable --silent --proto '=http,https' --proto-redir '=http,https' \
 --noproxy '*' --connect-timeout 3 --max-time 8 --max-filesize 65536 \
 --output /dev/null --write-out '%{http_code}' \
 --config "$webhook_config" "$@" >"$webhook_result" 2>/dev/null
