#!/bin/sh
# Called only by the local manager with fixed operation names and private files.
# Caddy errors can contain credentials; never forward stdout/stderr to rpcd.
case "$1" in
 hash) umask 077; /usr/bin/caddy hash-password --algorithm bcrypt >"$2" 2>/dev/null ;;
 adapt)
  umask 077
  ulimit -f 128
  rm -f "$2.line" "$2.stderr"
  trap 'rm -f "$2.stderr"' EXIT INT TERM
  /usr/bin/caddy adapt --adapter caddyfile --config "$2" >"$2.json" 2>"$2.stderr"
  result=$?
  # Only numeric source positions survive. Never return CLI text or literals.
  if [ "$result" -ne 0 ]; then
   awk -v prefix="$2:" 'index($0,prefix) { value=substr($0,index($0,prefix)+length(prefix)); split(value,parts,":"); if (parts[1] ~ /^[0-9]+$/) {print parts[1]; exit} }' "$2.stderr" >"$2.line"
  fi
  exit "$result" ;;
 validate) exec /usr/bin/caddy validate --config "$2" >/dev/null 2>&1 ;;
 reload) exec /usr/bin/caddy reload --config "$2" --address "$3" >/dev/null 2>&1 ;;
 *) exit 1 ;;
esac
