#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034 # rc.common consumes these service declarations.

START=95
STOP=10
USE_PROCD=1

start_service() {
	[ -s /etc/caddy/active.json ] || return 1
	umask 077
	mkdir -p /etc/caddy/data
	chmod 0700 /etc/caddy /etc/caddy/data
	chmod 0600 /etc/caddy/active.json
	procd_open_instance caddy
	procd_set_param command /usr/bin/caddy run --config /etc/caddy/active.json
	procd_set_param env HOME=/etc/caddy XDG_DATA_HOME=/etc/caddy/data XDG_CONFIG_HOME=/etc/caddy
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/bin/caddy reload --config /etc/caddy/active.json --address 127.0.0.1:2019
}
